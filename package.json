{
  "name": "cv-zakia-jaya-berkah",
  "version": "1.0.0",
  "type": "module",
  "description": "Company Profile CV. ZAKIA JAYA BERKAH - Kontraktor Jalan dan Bangunan Gedung",
  "main": "index.html",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/style.css -o ./css/style.css --watch",
    "build:css": "tailwindcss -i ./src/style.css -o ./css/style.css --minify",
    "build": "npm run build:css && npm run prepare-dist",
    "prepare-dist": "node scripts/build.js",
    "start": "npx serve dist"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19"
  }
}
